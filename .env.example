# Local AWS test harness. Copy to .env at the repository root.
# Precedence (highest first): shell, explicit CLOUD_ENV/--env-file, .env.local, .env.
# Values are literal; no shell execution or variable expansion.

# Standard AWS credentials: use a profile OR temporary access keys/session token.
AWS_PROFILE=default
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

PROVIUM_CLOUD_TEST_ACCOUNT_ID=
CLOUDFORMATION_ROLE_ARN=
PROVIUM_CLOUD_TEST_STACK_PREFIX=provium-cloud-test
PROVIUM_CLOUD_TEST_TIMEOUT=1800

# GitHub repository variables (not needed locally):
# PROVIUM_CLOUD_LIVE_TESTS=true
# AWS_ROLE_ARN=arn:aws:iam::<account>:role/<GitHub-OIDC-role>
# Also set AWS_REGION, PROVIUM_CLOUD_TEST_ACCOUNT_ID and CLOUDFORMATION_ROLE_ARN.
# The caller needs CF stack operations/PassRole, ECR push, Batch submit/manage,
# S3 test reports/cleanup and CloudWatch read. The CF service role needs to manage
# this stack's EC2 networking, RDS/Secrets Manager (managed DB password),
# IAM roles/policies, Batch, S3, ECR and logs.
